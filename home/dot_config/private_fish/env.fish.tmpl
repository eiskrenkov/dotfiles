# Path
set PATH $HOME/bin $HOME/.local/bin /usr/local/bin /opt/homebrew/bin /opt/homebrew/bin/fish /opt/homebrew/opt/openssl@3/bin /opt/homebrew/opt/mysql-client@8.4/bin $PATH

# Set default language to english
set -gx LANG en_US.UTF-8
set -gx LC_ALL en_US.UTF-8

# Set default editor
set -gx EDITOR /usr/bin/nano

# GUI editor for this machine, as a CLI name resolved off PATH (`zed`, `cursor`,
# `code`, …) rather than a hard-coded path, so it survives a different brew
# prefix. Two things follow it: the `dotfiles` alias, and the tmux project
# pairing (scripts/sync-editor.sh — prefix+E and the pop-picker hook), which
# maps the CLI shim back to its .app and opens the project there. Unset it and
# that pairing is off on this machine.
set -gx GUI_EDITOR zed

set -gx SHELL $(which fish)
set -gx LDFLAGS '-L/opt/homebrew/opt/openssl@3/lib'
set -gx CPPFLAGS '-I/opt/homebrew/opt/openssl@3/include'
set -gx PKG_CONFIG_PATH /opt/homebrew/opt/openssl@3/lib/pkgconfig

# Set fzf options
# set -gx FZF_DEFAULT_OPTS '--height 30% --layout=reverse --border'

# pnpm
set -gx PNPM_HOME "/Users/eiskrenkov/Library/pnpm"
if not string match -q -- $PNPM_HOME $PATH
  set -gx PATH "$PNPM_HOME" $PATH
end

set -gx DYLD_LIBRARY_PATH (mise where ruby)/lib/

export GITHUB_TOKEN={{ onepasswordRead "op://4hukfa3qyxei7v47xvb7venmlq/xegt5kpqwi3jbcoxnnyv3zohse/credential" }}

# Claude code full screen rendering
# https://code.claude.com/docs/en/fullscreen
#
export CLAUDE_CODE_NO_FLICKER=1

# Claude Code: switch off the agent_summary side-query via a Bun preload
# https://gist.github.com/flamerix-ai/c3905705cc4205e5de3011fa2e74efce
set -l nas_preload "--preload=$HOME/.local/share/no-agent-summary.js"
if not string match -q -- "*$nas_preload*" "$BUN_OPTIONS"
  set -gx BUN_OPTIONS (string trim -- "$BUN_OPTIONS $nas_preload")
end
